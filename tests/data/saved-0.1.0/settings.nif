(.nif27)
(.vendor "viewSEG")
(settings
 (version 1)
 (theme "")
 (window
  (x 320)
  (y 140)
  (width 1280)
  (height 800)
  (maximized false))
 (recentFiles "/workspaces/viewSEG/exampleFiles/sample.sgd")
 (recentFolders "/workspaces/viewSEG/exampleFiles")
 (plot
  (mode wiggle)
  (fills positive)
  (overlap 1.0)
  (colours paper)
  (custom (background "#00000000") (line "#00000000") (positive "#00000000") (negative "#00000000") (hover "#00000000") (selected "#00000000"))
  (gain auto)
  (gainDb 0.0)
  (agcWindowMs 500.0)
  (normScope trace)
  (normStat percentile)
  (timeGain dbPerSecond)
  (dbPerS 6.0)
  (power 2.0)
  (clipPercentile 99.0)
  (order)
  (header auto))
 (scale
  (length inch)
  (speed false))
 (calibrations)
 (readout time trace channel receiver source ffid offset amplitude shotTime)
 (sortPresets
  (preset "Line/Station" (key rcvLine) (key rcvPoint))
  (preset "By Flag" (key rcvLine) (key rcvPoint) (key component))
  (preset "By Component" (key component) (key rcvLine) (key rcvPoint)))
 (customOrder)
 (messages
  (autoScroll true)
  (hide)))
