(.nif27)
; Vendor map for SEG-D Rev 3 files written by parseSSDAT from a vibrator controller's .dat
; signature file. SOURCE: parseSSDAT's own layout (its README and spec). Each shot (record) has
; the same 2048-byte shot block as its external header (64 blocks of 32 bytes): the decoded
; fields, the controller's 240-byte QC record and its three raw records.
; RECOGNITION: block 1 of the external header starts with the bytes "SSDATSHT".
; The polarity of the samples and of the ground force is never changed: they are as recorded.
(vendormap "parseSSDAT-segd-1" (version 1)
  (match (format segd) (rev 3.0 3.1) (hasBlock externalHeader (match (at 1) (bytes 0x53 0x53 0x44 0x41 0x54 0x53 0x48 0x54))))
  (doc "parseSSDAT shot block: vibrator controller .dat fields, QC record, raw records")
  (target (kind externalHeader) (name parseSSDATShot)
    (field magic (at 1) (len 8) (enc ascii))
    (field layoutVersion (at 9) (enc u16))
    (field blockBytes (at 11) (enc u16))
    (field unitSerial (at 13) (enc u32))
    (field fileNumber (at 17) (enc u32))
    (field firmwareMajor (at 21) (enc u8))
    (field firmwareMinor (at 22) (enc u8))
    (field complete (at 23) (enc u8) (enum (0 "incomplete") (1 "complete")))
    (field channels (at 24) (enc u8))
    (field samples (at 25) (enc u32))
    (field declaredSamples (at 29) (enc u32))
    (field sampleIntervalUs (at 33) (enc f64) (unit "us"))
    (field triggerYear (at 41) (enc u16))
    (field triggerMonth (at 43) (enc u8))
    (field triggerDay (at 44) (enc u8))
    (field triggerHour (at 45) (enc u8))
    (field triggerMinute (at 46) (enc u8))
    (field triggerSecond (at 47) (enc u8))
    (field triggerNanosecond (at 49) (enc u32) (unit "ns"))
    (field sourceLine (at 53) (enc u32) (sentinel 0))
    (field sourceStation (at 57) (enc u32) (sentinel 0))
    (field shotId (at 61) (enc u32) (sentinel 0))
    (field sourceIndex (at 65) (enc u32) (sentinel 0))
    (field trailerCounter (at 69) (enc u32))
    (field sweepId (at 73) (enc u32))
    (field ggaLatitude (at 77) (enc f64) (unit "deg"))
    (field ggaLongitude (at 85) (enc f64) (unit "deg"))
    (field ggaAltitude (at 93) (enc f64) (unit "m"))
    (field ggaGeoidSeparation (at 101) (enc f64) (unit "m"))
    (field ggaHdop (at 109) (enc f32))
    (field ggaFixQuality (at 113) (enc u8))
    (field ggaSatellites (at 114) (enc u8))
    (field ggaValid (at 115) (enc u8) (enum (0 "no") (1 "yes")))
    (field fixLatitude (at 117) (enc f64) (unit "deg"))
    (field fixLongitude (at 125) (enc f64) (unit "deg"))
    (field fixHeight (at 133) (enc i16) (scale 0.1) (unit "m"))
    (field fixQuality (at 135) (enc u8))
    (field fixSatellites (at 136) (enc u8))
    (field fixHdop (at 137) (enc u8) (scale 0.1))
    (field lbfPerCount (at 145) (enc f64) (unit "lbf")) ; 0: not given
    (field scaleReference (at 153) (enc f64))
    (field scaleMass (at 161) (enc f64))
    (field scaleBaseplate (at 169) (enc f64))
    (field meanRemoved (at 177) (enc u8) (enum (0 "no") (1 "yes")))
    (field groundForceTrace (at 178) (enc u8) (enum (0 "no") (1 "yes")))
    (field groundForcePolarity (at 179) (enc u8) (enum (0 "as recorded: opposite to the reference")))
    (field positions (at 180) (enc u8) (enum (0 "none") (1 "GGA sentence") (2 "binary fix")))
    (field incompleteWhy (at 181) (len 76) (enc ascii) (trim right))
    ; the controller's QC record, bytes 257-496 (record offset o is block byte 257 + o)
    (field qcCrew (at 261) (enc u8))
    (field qcVibratorId (at 263) (enc u8))
    (field qcMessageType (at 265) (enc u8))
    (field qcSweepId (at 266) (enc u32))
    (field qcSweepNumber (at 270) (enc u8))
    (field qcPhaseMax (at 273) (enc u8) (scale 0.125) (unit "deg"))
    (field qcForceMax (at 276) (enc u8) (unit "%"))
    (field qcForceMin (at 277) (enc u8) (unit "%"))
    (field qcForceAvg (at 278) (enc u8) (unit "%"))
    (field qcThdMax (at 279) (enc u8) (unit "%"))
    (field qcThdAvg (at 280) (enc u8) (unit "%"))
    (field qcSweepChecksum (at 281) (enc u16))
    (field qcParamChecksum (at 283) (enc u16))
    (field qcStatus1 (at 285) (enc u8))
    (field qcStatus2 (at 286) (enc u8))
    (field qcStatus3 (at 287) (enc u8))
    (field qcLimits (at 288) (enc u8) (bits (0 T) (1 M) (2 V) (3 F) (4 R)))
    (field qcCorrelationMagnitude (at 293) (enc u16))
    (repeat (count 128) (stride 1) (at 295) (field corr (at 1) (enc i8)))
    (field qcYear2 (at 423) (enc u8))
    (field qcMonth (at 424) (enc u8))
    (field qcDay (at 425) (enc u8))
    (field qcHour (at 426) (enc u8))
    (field qcMinute (at 427) (enc u8))
    (field qcSecond (at 428) (enc u8))
    (field qcNanosecond (at 429) (enc u32) (unit "ns"))
    (field qcHeightAboveEllipsoid (at 442) (enc u32) (scale 0.01) (unit "m"))
    (field qcSatellites (at 446) (enc u8))
    (field qcPdop (at 447) (enc u8) (scale 0.1))
    (field qcHdop (at 448) (enc u8) (scale 0.1))
    (field qcVdop (at 449) (enc u8) (scale 0.1))
    (field qcCorrectionAge (at 450) (enc u8) (unit "s"))
    (field qcSignatureFileCounter (at 454) (enc u32))
    (field qcFlashFree (at 458) (enc u8) (unit "%"))
    (field qcStiffnessMax (at 460) (enc u8))
    (field qcStiffnessMin (at 461) (enc u8))
    (field qcStiffnessAvg (at 462) (enc u8))
    (field qcViscosityMax (at 463) (enc u8))
    (field qcViscosityMin (at 464) (enc u8))
    (field qcViscosityAvg (at 465) (enc u8))
    (field qcTargetForce (at 466) (enc u16) (unit "lbf"))
    (field qcShotId (at 475) (enc u32))
    (field qcSourceLine (at 479) (enc u32))
    (field qcSourceStation (at 483) (enc u32))
    ; the .dat's own records, verbatim (the QC record's raw bytes are the stanza's own bytes
    ; 257-496: no raw field overlaps the decoded ones)
    (field headerRecordStart (at 513) (len 280) (enc raw))
    (field gnssText (at 793) (len 212) (enc ascii) (trim right))
    (field headerRecordEnd (at 1005) (len 20) (enc raw))
    (field positionRecord (at 1025) (len 512) (enc raw))
    (field trailerRecord (at 1537) (len 512) (enc raw))))
