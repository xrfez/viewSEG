(.nif27)
; Vendor map for SEG-Y files written by parseSSVIB from a vibrator controller's .vib signature
; record. SOURCE: parseSSVIB's own layout (its README and spec). Each shot is one binary stanza
; ((parseSSVIB:Shot v1:application/octet-stream:1280)) in the extended textual header: the
; decoded fields, the options the traces were written with, the trace table and the file's
; 47-byte header verbatim.
; RECOGNITION: the textual header's card "PARSESSVIB SHOT STANZAS VERSION 1".
; The block is big-endian whatever the file's byte order; the .vib header inside it is the
; file's own bytes, little-endian. Samples and the computed ground forces are as recorded.
(vendormap "parseSSVIB-segy-1" (version 1)
  (match (format segy) (textContains "PARSESSVIB SHOT STANZAS VERSION 1"))
  (doc "parseSSVIB shot block: vibrator controller .vib fields, options, trace table, header")
  (target (kind stanza) (stanza "parseSSVIB:Shot v1") (name parseSSVIBShot)
    (field magic (at 1) (len 8) (enc ascii))
    (field layoutVersion (at 9) (enc u16) (byteOrder big))
    (field blockBytes (at 11) (enc u16) (byteOrder big))
    (field record (at 13) (enc u32) (byteOrder big))
    (field nameNumber (at 17) (enc u32) (byteOrder big) (sentinel 0xFFFFFFFF))
    (field controllerSerial (at 21) (enc u32) (byteOrder big) (sentinel 0xFFFFFFFF))
    (field datFileNumber (at 25) (enc u32) (byteOrder big) (sentinel 0xFFFFFFFF))
    (field complete (at 29) (enc u8) (enum (0 "incomplete") (1 "complete")))
    (field endsInSweep (at 30) (enc u8) (enum (0 "no") (1 "yes: a stopped recording")))
    (field traces (at 31) (enc u8))
    (field groundForcePolarity (at 32) (enc u8) (enum (0 "as recorded")))
    (field frames (at 33) (enc u32) (byteOrder big))
    (field firstFrame (at 37) (enc u32) (byteOrder big))
    (field samples (at 41) (enc u32) (byteOrder big))
    (field tailBytes (at 45) (enc u32) (byteOrder big))
    (field sampleIntervalUs (at 49) (enc f64) (byteOrder big) (unit "us"))
    (field t0Ms (at 57) (enc f64) (byteOrder big) (unit "ms"))
    (field timeZeroSeconds (at 65) (enc i64) (byteOrder big) (unit "s"))
    (field timeZeroNanosecond (at 73) (enc u32) (byteOrder big) (unit "ns"))
    (field timeAxis (at 77) (enc u8) (enum (0 "trigger") (1 "first frame")))
    (field timeZero (at 78) (enc u8) (enum (0 "the trigger frame") (1 "the first frame")))
    (field triggerSource (at 79) (enc u8)
      (enum (0 "none") (1 "estimated from the reference") (2 "given by the caller")))
    (field triggerKnown (at 80) (enc u8) (enum (0 "no") (1 "yes: given by the caller")))
    (field triggerFrame (at 81) (enc f64) (byteOrder big))
    (field triggerSigmaFrames (at 89) (enc f64) (byteOrder big))
    (group (when (field triggerKnown) (is 1))
      (field triggerYear (at 97) (enc u16) (byteOrder big))
      (field triggerMonth (at 99) (enc u8))
      (field triggerDay (at 100) (enc u8))
      (field triggerHour (at 101) (enc u8))
      (field triggerMinute (at 102) (enc u8))
      (field triggerSecond (at 103) (enc u8))
      (field triggerNanosecond (at 105) (enc u32) (byteOrder big) (unit "ns")))
    (field sweepValid (at 113) (enc u8) (enum (0 "no") (1 "yes")))
    (field sweepCrossings (at 117) (enc u32) (byteOrder big))
    (field sweepTriggerFrame (at 121) (enc f64) (byteOrder big))
    (field sweepTriggerSigmaFrames (at 129) (enc f64) (byteOrder big))
    (field sweepStartHz (at 137) (enc f64) (byteOrder big) (unit "Hz"))
    (field sweepRateHzPerS (at 145) (enc f64) (byteOrder big) (unit "Hz/s"))
    (field sweepResidualCycles (at 153) (enc f64) (byteOrder big))
    (field sweepRmsCycles (at 161) (enc f64) (byteOrder big))
    (field units (at 169) (enc u8) (enum (0 "counts") (1 "physical")))
    (field force (at 170) (enc u8) (enum (0 "no: g") (1 "yes: lbf")))
    (field removeMean (at 171) (enc u8) (enum (0 "no") (1 "yes")))
    (field cycleValues (at 172) (enc u8) (enum (0 "no") (1 "yes")))
    (field groundForce (at 173) (enc u8) (bits (0 setA) (1 setB)))
    (field primary (at 174) (enc u8) (enum (0 "A") (1 "B")))
    (field traceOrder (at 175) (enc u8) (enum (0 "file") (1 "forces")))
    (field externalConverter (at 176) (enc u8) (enum (0 "no") (1 "yes")))
    (field segdReference (at 177) (enc u8)
      (enum (150 "source reference sweep") (152 "source reference pilot")))
    (field channels (at 179) (enc u16) (byteOrder big)
      (bits (0 reference) (1 baseplateA) (2 massA) (3 baseplateB) (4 massB) (5 torqueMotor)
        (6 valve) (7 massStroke) (8 drive)))
    (field accMvPerCount (at 181) (enc f64) (byteOrder big))
    (field torquePctPerCount (at 189) (enc f64) (byteOrder big))
    (field lvdtFactor (at 197) (enc f64) (byteOrder big))
    (field drivePerCount (at 205) (enc f64) (byteOrder big))
    ; the .vib file's 47-byte header, verbatim at bytes 257-303 (header offset o is block
    ; byte 257 + o), decoded in place in the file's own byte order
    (field vibMagic (at 257) (len 3) (enc ascii))
    (field channelsPerFrame (at 260) (enc u8))
    (field valveCal (at 261) (enc f32) (byteOrder little))
    (field massCal (at 265) (enc f32) (byteOrder little))
    (field unknown12 (at 269) (enc f32) (byteOrder little))
    (field unknown16 (at 273) (enc f32) (byteOrder little))
    (field holdDownLb (at 277) (enc f32) (byteOrder little) (unit "lb"))
    (field sensitivity1 (at 281) (enc f32) (byteOrder little))
    (field sensitivity2 (at 285) (enc f32) (byteOrder little))
    (field baseplateLb (at 289) (enc f32) (byteOrder little) (unit "lb"))
    (field massLb (at 293) (enc f32) (byteOrder little) (unit "lb"))
    (field startSecond (at 297) (enc u8))
    (field startMinute (at 298) (enc u8))
    (field startHour (at 299) (enc u8))
    (field startDay (at 300) (enc u8))
    (field startMonth (at 301) (enc u8))
    (field startYear (at 302) (enc u16) (byteOrder little))
    ; the trace table: one entry of 48 bytes per trace written, in the order written
    (repeat (count (ref traces)) (stride 48) (at 321)
      (field traceChannel (at 1) (enc u8))
      (field traceSource (at 2) (enc u8)
        (enum (0 "reference") (1 "baseplate acceleration, set A")
          (2 "reaction-mass acceleration, set A") (3 "baseplate acceleration, set B")
          (4 "reaction-mass acceleration, set B") (5 "torque-motor current")
          (6 "valve displacement") (7 "mass displacement") (8 "drive output (probable)")
          (9 "per-cycle value 1") (10 "per-cycle value 2")
          (11 "ground force, estimated, from accelerometer set A")
          (12 "ground force, estimated, from accelerometer set B")))
      (field traceCode (at 3) (enc i16) (byteOrder big))
      (field traceSegdType (at 5) (enc u8)
        (enum (147 "source signature, estimated") (149 "source base plate")
          (150 "source reference sweep") (151 "source other") (152 "source reference pilot")
          (153 "source mass") (154 "source excitation") (155 "source valve")))
      (field traceUnit (at 6) (enc u8)
        (enum (0 "counts") (1 "pound-counts") (2 "lbf") (3 "g") (4 "percent")
          (5 "as stored") (6 "unit unknown")))
      (field traceFactor (at 9) (enc f64) (byteOrder big))
      (field traceMean (at 17) (enc f64) (byteOrder big))
      (field traceFactor2 (at 25) (enc f64) (byteOrder big))
      (field traceMean2 (at 33) (enc f64) (byteOrder big)))
    (field incompleteWhy (at 1089) (len 76) (enc ascii) (trim right))))
